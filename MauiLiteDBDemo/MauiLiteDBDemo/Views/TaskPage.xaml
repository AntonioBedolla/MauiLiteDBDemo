        <CollectionView ItemsSource="{Binding Tasks}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- CheckBox para completar la tarea -->
                        <CheckBox IsChecked="{Binding IsCompleted}">
                                      <CheckBox.Behaviors>
                                    <local:CheckBoxBehavior Command="{Binding Source={RelativeSource AncestorType={x:Type views:TaskPage}},
                                                            Path=BindingContext.ToggleCompleteCommand}" />
                                </CheckBox.Behaviors>
                                </CheckBox>

                            <!-- Nombre de la tarea -->
                            <Label Text="{Binding Name}"
                                   VerticalOptions="CenterAndExpand"
                                   FontSize="20"
                                   Margin="10,0"/>

                            <!-- Botón para eliminar tarea -->
                            <Button Text="❌"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type views:TaskPage}}, Path=BindingContext.DeleteTaskCommand}"
                                    CommandParameter="{Binding}"
                                    BackgroundColor="Transparent"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
