             xmlns:views="clr-namespace:MauiLiteDBDemo.Views"
             x:Class="MauiLiteDBDemo.Views.TaskPage"
             Title="TaskPage">
    <VerticalStackLayout Padding="20">
        
        <Entry Placeholder="Nueva tarea" Text="{Binding TaskName}" />

        <Button Text="Agregar Tarea"
                Command="{Binding AddTaskCommand}"
                BackgroundColor="DodgerBlue" 
                TextColor="White"/>
        
